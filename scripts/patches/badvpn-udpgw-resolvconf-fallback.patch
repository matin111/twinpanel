@@ -1433,6 +1435,35 @@
 int uint16_comparator (void *unused, uint16_t *v1, uint16_t *v2)
 {
     return B_COMPARE(*v1, *v2);
+}
+
+static int read_resolv_conf_dns (BAddr *out)
+{
+#ifndef BADVPN_USE_WINAPI
+    FILE *f = fopen("/etc/resolv.conf", "r");
+    if (!f) {
+        return 0;
+    }
+
+    char line[512];
+    while (fgets(line, sizeof(line), f)) {
+        char key[32];
+        char value[64];
+        if (sscanf(line, " %31s %63s", key, value) != 2 || strcmp(key, "nameserver")) {
+            continue;
+        }
+
+        struct in_addr ipv4;
+        if (inet_pton(AF_INET, value, &ipv4) == 1) {
+            BAddr_InitIPv4(out, ipv4.s_addr, hton16(53));
+            fclose(f);
+            return 1;
+        }
+    }
+
+    fclose(f);
+#endif
+    return 0;
 }
 
