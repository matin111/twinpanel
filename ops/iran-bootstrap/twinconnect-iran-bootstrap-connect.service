[Unit]
Description=TwinConnect Iran first-login and server-list HTTPS CONNECT gateway
Documentation=https://github.com/matin111/twinpanel/tree/main/ops/iran-bootstrap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/twinconnect_iran_connect_proxy.py --bind 0.0.0.0 --port 80 --upstream-ip 217.179.6.142 --upstream-port 443
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
LimitNOFILE=8192
TasksMax=128
MemoryMax=160M
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
