{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {
      "tag": "local-test",
      "listen": "127.0.0.1",
      "port": 20889,
      "protocol": "socks",
      "settings": {"auth": "noauth", "udp": false}
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              {"id": "00000000-0000-4000-8000-000000000001", "encryption": "none"}
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {"serverName": "example.com"}
      }
    }
  ]
}
