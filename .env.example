# Browser requests stay same-origin by default.
# Leave empty in production so the UI calls /v1/* on its own host.
NEXT_PUBLIC_API_BASE=

# Internal backend target used by Next/Nginx runtime proxying.
TWINPANEL_BACKEND_URL=http://127.0.0.1:8095

# Branding is managed from the Branding section, not hard-coded here.
NEXT_PUBLIC_APP_NAME=
