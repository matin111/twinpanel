[Unit]
Description=TwinPanel Automatic Backup Worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
ConditionPathExists=/etc/twinpanel/backend.env
ConditionPathExists=/opt/twinpanel/current/backend/app/backup_worker.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/twinpanel/current/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/twinpanel/backend.env
ExecStart=/opt/twinpanel/venv/bin/python3 -m app.backup_worker
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
