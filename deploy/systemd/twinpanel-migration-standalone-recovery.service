[Unit]
Description=TwinPanel recover missing standalone protocols on eligible migrated subscriptions
After=network-online.target postgresql.service twinpanel-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/twinpanel/current/backend
EnvironmentFile=/etc/twinpanel/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=STANDALONE_RECOVERY_MAX_ACCOUNTS=6
ExecStart=/opt/twinpanel/venv/bin/python3 -u /opt/twinpanel/current/backend/scripts/twinpanel_migration_standalone_recovery_v1.py
TimeoutStartSec=800
SuccessExitStatus=2 3
Nice=15
CPUWeight=10
CPUQuota=65%
IOWeight=10
