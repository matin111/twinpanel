[Unit]
Description=TwinPanel automatic SSH-verified Cisco server certificate pin synchronization
After=network-online.target postgresql.service twinpanel-api.service
Wants=network-online.target
ConditionPathExists=/opt/twinpanel/current/backend/scripts/twinpanel_cisco_cert_pin_sync_v1.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/twinpanel/current/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/twinpanel/backend.env
Environment=PYTHONPATH=/opt/twinpanel/current/backend
ExecStart=/opt/twinpanel/venv/bin/python3 -u /opt/twinpanel/current/backend/scripts/twinpanel_cisco_cert_pin_sync_v1.py
TimeoutStartSec=180
Nice=10
