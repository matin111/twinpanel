[Unit]
Description=TwinPanel durable retry of recently created incomplete Modern credentials
After=network-online.target postgresql.service twinpanel-api.service
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/twinpanel/current/backend
EnvironmentFile=/etc/twinpanel/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=RECENT_RECOVERY_MAX_ACCOUNTS=2
Environment=RECENT_RECOVERY_MAX_PROTOCOLS=2
ExecStart=/opt/twinpanel/venv/bin/python3 -u /opt/twinpanel/current/backend/scripts/twinpanel_recent_account_recovery_v1.py
Nice=15
CPUWeight=10
CPUQuota=60%
IOWeight=10
TimeoutStartSec=600
SuccessExitStatus=2 3