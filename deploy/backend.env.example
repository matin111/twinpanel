# TwinPanel backend runtime example
# Copy to /etc/twinpanel/backend.env and replace generated secrets during install.

APP_NAME=TwinPanel
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME_GENERATED_64_HEX
DATABASE_URL=postgresql+psycopg2://twinpanel:CHANGE_ME@127.0.0.1:5432/twinpanel
REDIS_URL=redis://127.0.0.1:6379/0
NODE_AGENT_SHARED_SECRET=CHANGE_ME_GENERATED_64_HEX
PUBLIC_API_FALLBACK=http://127.0.0.1:8095

# Commercial release / update channel.
TWINPANEL_RELEASE_CHANNEL=stable
TWINPANEL_RELEASE_MANIFEST_URL=https://raw.githubusercontent.com/matin111/tp27-core/main/twinpanel/releases/stable.json

# Vendor license API is configured by the official bootstrap installer.
# Never put the vendor signing PRIVATE key on a customer server.
TWINPANEL_LICENSE_API_URL=
TWINPANEL_LICENSE_PUBLIC_KEY_FILE=/etc/twinpanel/license-public.pem
TWINPANEL_LICENSE_ENFORCE=0
TWINPANEL_LICENSE_OFFLINE_GRACE_SECONDS=172800

# Installed release identity.
TWINPANEL_VERSION_FILE=/opt/twinpanel/current/VERSION
