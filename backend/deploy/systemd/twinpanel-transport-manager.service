[Unit]
Description=TwinPanel Transport Manager V12 Smart Iran Path + Multi-Tunnel Self-Heal
After=network-online.target twinpanel-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/twinpanel-product/backend

EnvironmentFile=/etc/twinpanel/backend.env
Environment=PYTHONPATH=/opt/twinpanel-product/backend
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/twinpanel/venv/bin/python -u -m app.tunnel_transport_manager_v12

Restart=always
RestartSec=3
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
